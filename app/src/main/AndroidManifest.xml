<?xml version="1.0" encoding="utf-8"?>
<!--
  Hattie — the tablet app.

  THREE PERMISSIONS MATTER, and they are the whole of why this is an app
  rather than a browser page:

    * RECORD_AUDIO — a page is only allowed a microphone on a secure
      origin, and that rule is enforced by Chromium INSIDE the app as well
      as in a browser. This was wrong for a week and cost a tablet: the app
      granted the request in onPermissionRequest, but over plain http the
      page never asks, so the grant never happened and no dialog ever
      appeared. The box now serves https (its own certificate, accepted by
      the app — see Trust.kt), which is what makes this permission mean
      anything.
    * FOREGROUND_SERVICE + FOREGROUND_SERVICE_MICROPHONE — a microphone
      held by a background service: Android insists it is visible, which is
      right, and the notification is that promise kept.
    * RECEIVE_BOOT_COMPLETED — it comes back by itself after a power cut,
      which is the difference between an appliance and a gadget.

  usesCleartextTraffic stays on only so an older box with no certificate
  can still be reached while it is being set up. Her page itself is served
  over https now, because that is the only way it may have a microphone.
  Nothing
  in this app talks to anything but the box it was paired with; there is no
  analytics, no update check to a third party and no account anywhere.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- A tablet with no microphone should still install, and say so, rather
         than be filtered out of the shop by the store. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- allowBackup is off because a device token must never be swept into a
         cloud backup: this tablet's credential belongs to this tablet. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- MAIN + HOME: it can be set as the home app, so a tablet in a
             kitchen has nothing on it but her. LAUNCHER is kept as well so
             it can be opened by hand while it is being set up. -->
        <!-- turnScreenOn + showWhenLocked: a tablet that has been asleep is
             her again without anybody unlocking anything (API 27+; the same
             is asked for in code, so an older Android still behaves). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".EarService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The microphone belongs to her page. The boot receiver went on
             31 Oct 2026: it existed to start a background AudioRecord after
             a power cut, and a background AudioRecord plus the WebView cannot
             both hold the microphone - the loser is her page, which reports
             NotReadableError and cannot hear anybody. -->
    </application>
</manifest>
